{% extends 'base.html.twig' %}

{% block title %}Batch report{% endblock %}

{% block body %}
    <h1>Compte rendu d'import</h1>

    <p>Ajout de {{ count }} chaînes sur {{ total }}.</p>

    <ul>
    {% for message in messages %}
        <li>{{ message }}</li>
    {% else %}
        <p>No error</p>
    {% endfor %}
    </ul>

    <a href="{{ path('app_channel_index') }}">Back to index</a>
{% endblock %}
