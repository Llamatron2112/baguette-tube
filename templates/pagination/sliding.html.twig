{# custom Sliding pagination control implementation #}
{% if pageCount > 1 %}
    <div class="pagination">
        {% if first is defined and current != first %}
            <span class="first">
                <a href="{{ path(route, knp_pagination_query(query, first, options)) }}">{{ first }}</a>
            </span>
        {% endif %}

        {% if previous is defined %}
            <span class="previous">
                <a rel="prev" href="{{ path(route, knp_pagination_query(query, previous, options)) }}">Préc</a>
            </span>
        {% endif %}

        <span class="current">
            <form method="get">
                <input type="number"
                        name="{{ pageParameterName }}"
                        min="1"
                        max="{{ pageCount }}"
                        value="{{ current }}">
            </form>
        </span>

        {% if next is defined %}
            <span class="next">
                <a rel="next" href="{{ path(route, knp_pagination_query(query, next, options)) }}">Suiv</a>
            </span>
        {% endif %}

        {% if last is defined and current != last %}
            <span class="last">
                 <a href="{{ path(route, knp_pagination_query(query, last, options)) }}">{{ last }}</a>
            </span>
        {% endif %}
    </div>
{% endif %}
